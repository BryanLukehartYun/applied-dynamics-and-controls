# --- MATLAB & Simulink (The Aerospace "Hard Physics" Layer) ---
*.asv              # Autosave files
*.slxc             # Simulink cache
*.mex* # Compiled MEX binaries (system-specific)
slprj/             # Simulink project generation folders
work/              # General simulation work directories
*.log              # Simulation and engine logs
*.mat              # ONLY if you are blocking large raw data; exclude 'data.mat' if needed
catdir/            # Catalog directories
diag/              # Diagnostic reports

# --- Simulink Compilation & Metadata ---
slprj/             # The "Simulation Project" folder (MUST BE IGNORED) 
*.slxc             # Simulink Cache files (prevents binary bloat) 
*.mex* # Compiled MEX files (platform-specific binaries) 

# --- Python  ---
__pycache__/       # Compiled bytecode
*.py[cod]
*$py.class
.venv/             # Virtual environments 
env/
venv/
.env               # Private environment variables

# --- MacOS/System Junk (Command Deck Noise) ---
.DS_Store          # macOS metadata
.AppleDouble
.LSOverride
Icon
Thumbs.db          # Windows legacy artifacts
ehthumbs.db

